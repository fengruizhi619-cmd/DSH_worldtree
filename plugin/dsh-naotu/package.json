{
    "name":  "dsh-naotu",
    "version":  "1.3.0",
    "description":  "脑图 —— DSH 记忆系统插件：元记忆 · 睡眠定盆 · 脑区 · 三通道赛马注入。",
    "private":  true,
    "type":  "module",
    "main":  "./lib/main.mjs",
    "exports":  {
                    ".":  "./lib/main.mjs",
                    "./package.json":  "./package.json",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./client":  "./lib/client.js"
                },
    "files":  [
                  "lib/",
                  "README.md"
              ],
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "\u003e=0.0.1-rc \u003c2",
                             "cordis":  "\u003e=4.0.0-rc \u003c5"
                         },
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "naotu",
                     "memory",
                     "brain-map"
                 ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ],
                               "platform":  "web",
                               "immediately":  true
                           }
            }
}
